rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    // Solo se gestiona desde la consola de Firebase.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /reportes/{id} {
      // Público: solo reportes aprobados. Nunca contiene RUT, teléfono ni sus hashes:
      // solo una máscara mínima (DV del RUT, 2 últimos dígitos del teléfono).
      allow get, list: if resource.data.estado == 'aprobado'
                       || isAdmin()
                       || (signedIn() && resource.data.creadoPor == request.auth.uid);

      // Crear: con login, siempre entra como 'pendiente' (moderación previa).
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['rutMask','telMask','titular','motivo','evidenciaPath',
              'nombreTokens','estado','creadoPor','creadoEn','aceptaTerminos'])
        && request.resource.data.keys().hasAll(
             ['titular','motivo','nombreTokens','estado','creadoPor','creadoEn','aceptaTerminos'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.aceptaTerminos == true
        && str(request.resource.data.titular, 3, 80)
        && str(request.resource.data.motivo, 20, 1000)
        && ('rutMask' in request.resource.data || 'telMask' in request.resource.data)
        && (!('rutMask' in request.resource.data) || request.resource.data.rutMask.matches('^[*]{2}[.][*]{3}[.][*]{3}-[0-9K]$'))
        && (!('telMask' in request.resource.data) || request.resource.data.telMask.matches('^(\\+56 9 )?[*]{4} [*]{2}[0-9]{2}$'))
        && (!('evidenciaPath' in request.resource.data)
            || request.resource.data.evidenciaPath.matches('^evidencias/' + request.auth.uid + '/' + id + '/[A-Za-z0-9._-]{1,80}$'))
        // El dato real debe ir en el mismo lote, en privado/datos.
        && existsAfter(/databases/$(database)/documents/reportes/$(id)/privado/datos)
        && request.resource.data.nombreTokens is list
        && request.resource.data.nombreTokens.size() <= 8;

      // Moderación: solo admin cambia estado / nota.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado','notaModeracion','moderadoPor','moderadoEn'])
        && request.resource.data.estado in ['pendiente','aprobado','rechazado','retirado'];

      allow delete: if isAdmin();

      // RUT y teléfono reales: solo autor y admin.
      match /privado/{docId} {
        function padre() { return getAfter(/databases/$(database)/documents/reportes/$(id)).data; }
        function hashHex(v) { return hashing.sha256(v).toHexString().lower(); }
        function indexado(v) {
          return existsAfter(/databases/$(database)/documents/indice/$(hashHex(v))/r/$(id));
        }
        function d() { return request.resource.data; }
        allow get: if isAdmin()
          || (signedIn() && get(/databases/$(database)/documents/reportes/$(id)).data.creadoPor == request.auth.uid);
        allow create: if signedIn()
          && docId == 'datos'
          && !exists(/databases/$(database)/documents/reportes/$(id))
          && padre().creadoPor == request.auth.uid
          && d().keys().hasOnly(['rut','telefono'])
          && ('rut' in d()) == ('rutMask' in padre())
          && ('telefono' in d()) == ('telMask' in padre())
          && (!('rut' in d()) || (d().rut.matches('^[0-9]{7,8}-[0-9K]$') && indexado(d().rut)))
          && (!('telefono' in d()) || (d().telefono.matches('^[0-9]{8,12}$') && indexado(d().telefono)));
        allow list, update: if false;
        allow delete: if isAdmin();
      }
    }

    // Índice de búsqueda: indice/{sha256(dato)}/r/{reporteId}. Solo sirve a quien ya
    // conoce el RUT/teléfono exacto; no se puede listar el índice completo.
    match /indice/{hash}/r/{rid} {
      allow list, get: if true;
      allow create: if signedIn()
        && request.resource.data.keys().size() == 0
        && !exists(/databases/$(database)/documents/reportes/$(rid))
        && getAfter(/databases/$(database)/documents/reportes/$(rid)).data.creadoPor == request.auth.uid
        && (hashing.sha256(getAfter(/databases/$(database)/documents/reportes/$(rid)/privado/datos).data.get('rut', '-')).toHexString().lower() == hash
            || hashing.sha256(getAfter(/databases/$(database)/documents/reportes/$(rid)/privado/datos).data.get('telefono', '-')).toHexString().lower() == hash);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Derecho a réplica / descargo: cualquiera con login puede enviar; solo admin lee.
    match /descargos/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporteId','mensaje','contacto','creadoPor','creadoEn'])
        && str(request.resource.data.reporteId, 1, 64)
        && str(request.resource.data.mensaje, 20, 2000)
        && str(request.resource.data.contacto, 5, 120)
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
